@model HomeModel
@{
    ViewData["Title"] = "Главная";
}
<h1>Управление библиотекой</h1>
<p>У одного автора может быть несколько книг, у каждой книги один автор</p>
<div class="table-wrap">
    <table>
        <thead><tr><th>Данные</th><th>Количество</th></tr></thead>
        <tbody>
            <tr><td>Авторы</td><td>@Model.AuthorsCount</td></tr>
            <tr><td>Книги</td><td>@Model.BooksCount</td></tr>
        </tbody>
    </table>
</div>
<div class="actions">
    <a class="button" asp-controller="Authors" asp-action="Index">Список авторов</a>
    <a class="button" asp-controller="Books" asp-action="Index">Список книг</a>
</div>
<p class="hint">При удалении автора все его книги также удаляются</p>

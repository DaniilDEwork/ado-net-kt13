@model AuthorForm
@{
    ViewData["Title"] = "Добавление автора";
}
<h1>Добавление автора</h1>
<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="All"></div>
    <partial name="_AuthorFields" model="Model" />
    <div class="actions">
        <button type="submit">Добавить автора</button>
        <a class="button" asp-action="Index">Отмена</a>
    </div>
</form>

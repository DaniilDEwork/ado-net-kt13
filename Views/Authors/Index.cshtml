@model List<Author>
@{
    ViewData["Title"] = "Авторы";
}
<h1>Авторы</h1>
<a class="button" asp-action="Create">Добавить автора</a>
@if (Model.Count == 0)
{
    <p>Список авторов пуст</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Имя</th><th>Количество книг</th><th>Действия</th></tr></thead>
            <tbody>
            @foreach (var author in Model)
            {
                <tr>
                    <td>@author.AuthorId</td><td>@author.Name</td><td>@author.Books.Count</td>
                    <td><div class="table-actions">
                        <a asp-action="Details" asp-route-id="@author.AuthorId">Просмотр</a>
                        <a asp-action="Edit" asp-route-id="@author.AuthorId">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@author.AuthorId">Удалить</a>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

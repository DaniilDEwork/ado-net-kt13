@model List<Book>
@{
    ViewData["Title"] = "Книги";
}
<h1>Книги</h1>
<a class="button" asp-action="Create">Добавить книгу</a>
@if (Model.Count == 0)
{
    <p>Список книг пуст</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Название</th><th>ID автора</th><th>Автор</th><th>Действия</th></tr></thead>
            <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.BookId</td><td>@book.Title</td><td>@book.AuthorId</td>
                    <td><a asp-controller="Authors" asp-action="Details" asp-route-id="@book.AuthorId">@book.Author.Name</a></td>
                    <td><div class="table-actions">
                        <a asp-action="Details" asp-route-id="@book.BookId">Просмотр</a>
                        <a asp-action="Edit" asp-route-id="@book.BookId">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@book.BookId">Удалить</a>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

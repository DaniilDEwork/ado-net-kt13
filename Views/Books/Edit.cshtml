@model BookForm
@{
    ViewData["Title"] = "Изменение книги";
}
<h1>Изменение книги</h1>
<p>ID книги: @Model.BookId</p>
<form asp-action="Edit" asp-route-id="@Model.BookId" method="post" novalidate>
    <div asp-validation-summary="All"></div>
    <partial name="_BookFields" model="Model" />
    <div class="actions">
        <button type="submit">Сохранить изменения</button>
        <a class="button" asp-action="Details" asp-route-id="@Model.BookId">Отмена</a>
    </div>
</form>

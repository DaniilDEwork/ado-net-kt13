@model BookForm
<label asp-for="Title">Название книги</label>
<input asp-for="Title" maxlength="200" />
<span asp-validation-for="Title"></span>
<label asp-for="AuthorId">Автор</label>
<select asp-for="AuthorId" asp-items="Model.Authors">
    <option value="">Выберите автора</option>
</select>
<span asp-validation-for="AuthorId"></span>

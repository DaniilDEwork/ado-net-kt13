<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - КТ-13</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="container">
            <div class="site-title">КТ-13 - Отношения один ко многим</div>
            <nav>
                <a asp-controller="Home" asp-action="Index">Главная</a>
                <a asp-controller="Authors" asp-action="Index">Авторы</a>
                <a asp-controller="Books" asp-action="Index">Книги</a>
            </nav>
        </div>
    </header>
    <main class="container content">
        @if (TempData["Success"] is string message)
        {
            <p class="success">@message</p>
        }
        @RenderBody()
    </main>
    <footer class="container">ADO.NET - ASP.NET Core MVC - КТ-13</footer>
</body>
</html>
